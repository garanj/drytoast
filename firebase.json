{
  "hosting": {
    "public": "site",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/hardened-mode",
        "destination": "/console/hardening",
        "type": 302
      },
      {
        "source": "/downloads/threshold-release.apk",
        "destination": "https://github.com/garanj/threshold/releases/latest/download/threshold-release.apk",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**/*.@(png|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/provisioning-qr-payload.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
