    <string name="dpc_admin_description">Enables Dry Toast Hardened Mode for OS-level package suspension and tamper resistance.</string>
    <string name="hardened_mode_title">Hardened Mode</string>
    <string name="hardened_mode_status_active_label">STATUS: HARDENED MODE ACTIVE</string>
    <string name="hardened_mode_status_inactive_label">STATUS: STANDARD MODE (NOT ENABLED)</string>
    <string name="hardened_mode_status_active_body">Dry Toast holds Device Owner privileges. Blocked and Guarded apps are suspended at the OS level and launcher self-protection is active.</string>
    <string name="hardened_mode_status_inactive_body">Dry Toast is running as a standard intent gatekeeper. Blocked apps are hidden from Dry Toast\'s launcher surfaces, but can still be opened via the Android Recents switcher, notifications, or external deep links.</string>
    <string name="hardened_mode_section_controls">Hardened Mode Controls</string>
    <string name="setting_block_new_app_installs_title">Block new app installs</string>
    <string name="setting_block_new_app_installs_summary">Prevents installing new apps from Google Play or other sources while enabled</string>
    <string name="setting_lock_screen_text_title">Lock screen text</string>
    <string name="setting_lock_screen_owner_preview">This device belongs to %1$s</string>
    <string name="setting_lock_screen_owner_name_label">Owner name</string>
    <string name="setting_lock_screen_info_label">Additional lock screen line (optional)</string>
    <string name="setting_lock_screen_info_placeholder">e.g. If found, please call…</string>
    <string name="hardened_mode_section_capabilities">What Hardened Mode Enforces</string>
    <string name="hardened_mode_cap_suspend_title">OS-Level Package Suspension</string>
    <string name="hardened_mode_cap_suspend_body">Suspends Blocked and Guarded apps in the Android OS (setPackagesSuspended). Blocked apps remain continuously suspended while active. Guarded apps are suspended at rest so they cannot be resumed from Recents, temporarily unsuspended when you pass a friction checkpoint, and re-suspended after the configured grace period when you return home or lock the screen.</string>
    <string name="hardened_mode_cap_home_title">Persistent Default Launcher</string>
    <string name="hardened_mode_cap_home_body">Locks Dry Toast as the persistent system Home app so the stock launcher cannot be re-selected in Android System Settings to bypass your rules.</string>
    <string name="hardened_mode_cap_tamper_title">Uninstall &amp; Force-Stop Protection</string>
    <string name="hardened_mode_cap_tamper_body">Disables Uninstall, Force Stop, and Clear Storage for Dry Toast in Android System Settings while Hardened Mode is active.</string>
    <string name="hardened_mode_section_companion">Companion Commitment Layers</string>
    <string name="hardened_mode_companion_intro">Hardened Mode closes Android OS escape hatches. Pair it with Dry Toast\'s Settings locks so rules cannot be weakened from inside Dry Toast:</string>
    <string name="hardened_mode_companion_reboot_title">Require Reboot for Settings Changes</string>
    <string name="hardened_mode_companion_reboot_body">Stages any edits to app rules, profiles, or triggers in Settings until you restart your phone.</string>
    <string name="hardened_mode_companion_adb_title">Settings Lock Console</string>
    <string name="hardened_mode_companion_adb_body">Completely locks Dry Toast Settings from being opened on the phone until unlocked from another device at drytoast.app/console.</string>
    <string name="hardened_mode_section_setup">Setup &amp; Removal</string>
    <string name="hardened_mode_setup_intro">Hardened Mode cannot be toggled from inside Dry Toast\'s normal menus. You can enable or disable it either by scanning the QR codes on the Dry Toast website or via USB debugging (ADB) from a computer.</string>
