<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug-only permission enabling on-device LocationManager.addTestProvider in instrumented tests -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation,ProtectedPermissions" />

    <application>
        <!-- Debug-only ADB config import receiver (completely absent from release builds) -->
        <receiver
            android:name=".debug.DebugConfigImportReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.garan.drytoast.debug.IMPORT_CONFIG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
